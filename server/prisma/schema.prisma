generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Usuario {
  id          Int           @id @default(autoincrement())
  nombre      String
  usuario     String         @unique
  password    String
  role        Role           @default(USER)
  UsuarioRuta UsuarioRuta[]
}

model UsuarioRuta {
  id        Int      @id @default(autoincrement())
  idUsuario Int
  idRuta    Int
  usuario   Usuario  @relation(fields: [idUsuario], references: [id])
  ruta      Ruta     @relation(fields: [idRuta], references: [id])

  @@index([idUsuario, idRuta]) // Índice compuesto para búsquedas rápidas
}

model Ruta {
  id                Int           @id @default(autoincrement())
  start             Float[]
  middle            Float[]
  end               Float[]
  idTipoCaminata    Int
  fechaCreacion     DateTime      @default(now())
  fechaModificacion DateTime      @updatedAt
  tipoCaminata      TipoCaminata  @relation(fields: [idTipoCaminata], references: [id])
  UsuarioRuta       UsuarioRuta[]
}

model TipoCaminata {
  id     Int     @id @default(autoincrement())
  nombre String
  linea  String?
  Ruta   Ruta[]
}
